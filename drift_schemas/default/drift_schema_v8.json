  "fixed_sql": [
    {
      "name": "db_lessons",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"db_lessons\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"topic\" TEXT NOT NULL, \"start\" INTEGER NOT NULL, \"duration_in_minutes\" INTEGER NOT NULL, \"note\" TEXT NULL, \"is_cancelled\" INTEGER NOT NULL CHECK (\"is_cancelled\" IN (0, 1)), \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "db_groups",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"db_groups\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"description\" TEXT NULL, \"avatar_path\" TEXT NULL, \"pay_rate\" REAL NOT NULL, \"period\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "db_students",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"db_students\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"contact\" TEXT NOT NULL, \"email\" TEXT NULL, \"avatar_path\" TEXT NULL, \"pay_rate\" REAL NOT NULL, \"period\" TEXT NOT NULL, \"notes\" TEXT NOT NULL, \"group_id\" INTEGER NULL REFERENCES db_groups (id) ON DELETE SET NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "db_lesson_participants",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"db_lesson_participants\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"lesson_id\" INTEGER NOT NULL REFERENCES db_lessons (id) ON DELETE CASCADE, \"student_id\" INTEGER NOT NULL REFERENCES db_students (id) ON DELETE CASCADE, \"is_paid\" INTEGER NOT NULL CHECK (\"is_paid\" IN (0, 1)), \"attended\" INTEGER NOT NULL CHECK (\"attended\" IN (0, 1)), \"homework_done\" INTEGER NOT NULL DEFAULT 0 CHECK (\"homework_done\" IN (0, 1)), \"group_id\" INTEGER NULL REFERENCES db_groups (id) ON DELETE SET NULL, \"pay_rate\" REAL NOT NULL DEFAULT 0.0, \"period\" TEXT NOT NULL DEFAULT 'perLesson', UNIQUE (\"lesson_id\", \"student_id\"));"
        }
      ]
    },
    {
      "name": "db_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"db_settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    }
  ]
